<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zm</groupId>
    <artifactId>Kilacraft-AI</artifactId>
    <version>2.1.1</version>
    <packaging>jar</packaging>

    <name>Kilacraft-AI</name>
    <description>一款强大的 Minecraft AI Agent 插件。</description>

    <properties>
        <!-- 主版本：Java 17 -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- 使用当前 JDK 编译，但生成 Java 17 兼容的字节码 -->
                    <release>17</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.36</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <relocations>
                        <!-- 重定位 Gson，避免与服务器内置版本冲突 -->
                        <relocation>
                            <pattern>com.google.gson</pattern>
                            <shadedPattern>com.zm.kilacraftAI.shaded.gson</shadedPattern>
                        </relocation>
                        <!-- 重定位 OkHttp，避免冲突 -->
                        <relocation>
                            <pattern>okhttp3</pattern>
                            <shadedPattern>com.zm.kilacraftAI.shaded.okhttp3</shadedPattern>
                        </relocation>
                        <relocation>
                            <pattern>okio</pattern>
                            <shadedPattern>com.zm.kilacraftAI.shaded.okio</shadedPattern>
                        </relocation>
                        <!-- 重定位 bStats，避免与其他插件冲突 -->
                        <relocation>
                            <pattern>org.bstats</pattern>
                            <shadedPattern>com.zm.kilacraftAI.shaded.bstats</shadedPattern>
                        </relocation>
                        <!-- 重定位 HikariCP -->
                        <relocation>
                            <pattern>com.zaxxer.hikari</pattern>
                            <shadedPattern>com.zm.kilacraftAI.shaded.hikari</shadedPattern>
                        </relocation>
                        <!-- 重定位 SLF4J API -->
                        <relocation>
                            <pattern>org.slf4j</pattern>
                            <shadedPattern>com.zm.kilacraftAI.shaded.slf4j</shadedPattern>
                        </relocation>
                        <!-- 重定位 H2 -->
                        <relocation>
                            <pattern>org.h2</pattern>
                            <shadedPattern>com.zm.kilacraftAI.shaded.h2</shadedPattern>
                        </relocation>
                    </relocations>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 测试插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- forked JVM 超时兜底：任何测试卡死时自动失败并打出线程转储，
                         而非永久挂起等待手动 kill -->
                    <forkedProcessTimeoutInSeconds>180</forkedProcessTimeoutInSeconds>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- JaCoCo 覆盖率（测试阶段生成 HTML/CSV 报告到 target/site/jacoco） -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Kilacraft-Skill-API.jar 生成插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>skill-api-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/skill-api.xml</descriptor>
                            </descriptors>
                            <finalName>Kilacraft-Skill-API-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <!-- Maven Central (log4j2 等 Apache 项目) -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>

        <!-- SpigotMC Repository -->
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        
        <!-- MythicMobs Repository -->
        <repository>
            <id>nexus</id>
            <name>Lumine Releases</name>
            <url>https://mvn.lumine.io/repository/maven-public/</url>
        </repository>

        <!-- Sonatype OSS (Spark API) -->
        <repository>
            <id>sonatype-oss-snapshots</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
        </repository>

        <!-- Lucko Repository (Spark API) -->
        <repository>
            <id>luck-repo</id>
            <url>https://repo.lucko.me/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spark API (性能监控插件) - provided scope，运行时由 Spark 插件提供 -->
        <dependency>
            <groupId>me.lucko</groupId>
            <artifactId>spark-api</artifactId>
            <version>0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.16.5-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Log4j Core (Paper 服务端运行时提供，用于 Spark 输出捕获) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.23.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.36</version>
            <scope>provided</scope>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

        <!-- HanLP 中文分词库 (轻量级 portable 版本) -->
        <dependency>
            <groupId>com.hankcs</groupId>
            <artifactId>hanlp</artifactId>
            <version>portable-1.8.4</version>
        </dependency>

        <!-- bStats 统计 -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.1.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- HikariCP 连接池 -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- SLF4J NOP 绑定 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- H2 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>

        <!-- Protobuf (用于 Spark Profiler 数据解析) -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.5</version>
        </dependency>

        <!-- MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>provided</scope>
        </dependency>
        
        <!-- MythicMobs Dependency (Provided) - 本地 JAR -->
        <dependency>
            <groupId>io.lumine</groupId>
            <artifactId>Mythic-Dist</artifactId>
            <version>5.12.0-5765</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/MythicMobs-5.12.0-5765.jar</systemPath>
        </dependency>
        
        <!-- GlobalMarketPlus Dependency (Provided) - 本地 JAR -->
        <dependency>
            <groupId>com.gmp</groupId>
            <artifactId>GlobalMarketPlus</artifactId>
            <version>1.3.8.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/GlobalMarketPlus-1.3.8.0.jar</systemPath>
        </dependency>

        <!-- CMI API Dependency (Provided) - 本地 JAR -->
        <dependency>
            <groupId>com.Zrips</groupId>
            <artifactId>CMI-API</artifactId>
            <version>9.8.6.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CMI-API9.8.6.4.jar</systemPath>
        </dependency>

        <!-- CMILib Dependency (Provided) - 本地 JAR -->
        <dependency>
            <groupId>com.Zrips</groupId>
            <artifactId>CMILib</artifactId>
            <version>1.5.8.9</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/CMILib1.5.8.9.jar</systemPath>
        </dependency>
    </dependencies>
</project>
